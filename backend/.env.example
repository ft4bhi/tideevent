# Copy to backend/.env and fill in. Never commit backend/.env to Git.
# The previously shared Neon password is treated as exposed: rotate it in the
# Neon console BEFORE any deployment, then put the fresh values here.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL (Neon console → Connect; sslmode=require is mandatory).
# App traffic MUST use the pooled string (hostname contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Migrations, pg_dump, and anything needing session state MUST use the direct string.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require
# When DATABASE_URL is unset, the backend falls back to local SQLite (dev/tests only).

# Frontend origin (CORS + CSRF trusted origins + invitation links)
FRONTEND_URL=http://localhost:3000
# Comma-separated overrides (default to FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Cookie security: default follows DEBUG (secure in prod). Override only deliberately.
# DJANGO_COOKIE_SECURE=True

# Organizer invitations: link expiry window
INVITATION_EXPIRY_DAYS=7

# Email (console backend prints mail locally; set real SMTP in deployment)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@example.com
